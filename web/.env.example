# Skopiuj do .env i uzupełnij. PLIK .env NIGDY NIE TRAFIA DO GITA.
# Rotacja klucza = edycja tej wartości + restart usługi (bez przebudowy klienta).

# === GoodDay ===
GOODDAY_API_TOKEN=
GOODDAY_PROJECT_ID=SnVrYd

# Autor przy tworzeniu zadania. "USER1-ID" to placeholder odziedziczony po
# aplikacji androidowej — GoodDay go ignoruje (zadanie nie ma autora). Zostawiony
# dla zgodności zachowania; wpisz prawdziwe ID, jeśli chcesz to naprawić.
GOODDAY_FROM_USER_ID=USER1-ID

# Użytkownik wykonujący zmianę statusu. MUSI być prawdziwym ID z GoodDay —
# placeholder daje 403, a brak pola 400. Domyślnie Marcel Wuwer (SPvGQx).
# Gdy ta osoba się zmieni, poprawiasz TYLKO tę linię.
GOODDAY_ACTOR_USER_ID=SPvGQx

# Status nadawany nowym zgłoszeniom: "Nowe". Projekt sam ustawia "Zaplanowane"
# (xuJ1Ih), dlatego jest osobny krok. Inne statusy w projekcie:
#   LeHvIP = W realizacij, EOGb6O = Zakończone
GOODDAY_NEW_STATUS_ID=pcqxl7

# === Imgur ===
# GoodDay v2 nie ma endpointu na załączniki, więc zdjęcia idą na Imgur, a do
# zadania trafia link. Upload robi serwer — Client-ID nie trafia do przeglądarki.
IMGUR_CLIENT_ID=

# === Aplikacja ===
PORT=8001
MAX_UPLOAD_MB=10
HTTP_CONNECT_TIMEOUT_SEC=10
HTTP_READ_TIMEOUT_SEC=60
