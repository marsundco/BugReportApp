[Unit]
Description=Karta niezgodnosci (WUWER)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/srv/wuwer/karty/web
EnvironmentFile=/srv/wuwer/karty/web/.env
ExecStart=/srv/wuwer/karty/web/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8001
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
